# Mongo host and credentials; database selection remains separate.
MONGODB_URI=mongodb://mongo:27017
# Application database name.
MONGODB_DB=eqip
# Local development identity mode only; production OIDC is intentionally out of scope.
AUTH_MODE=development
# Development actor used when no X-Dev-User header is supplied.
DEVELOPMENT_USER_ID=dev-portfolio-user
# Browser origin permitted for local Vite development.
CORS_ORIGINS=http://localhost:5173
